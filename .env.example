# LexiTag Environment Configuration
# Copy this file to .env and fill in your values.
# Never commit the actual .env file.

# ── AI Provider ──
# API key for the LLM provider (required)
LLM_API_KEY=your-api-key-here

# Base URL for the completions endpoint (defaults to Google Gemini)
LLM_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# Model identifier
LLM_MODEL=gemini-2.0-flash

# ── Security ──
# Optional: Require a bearer token to access the UI and API.
# If not set, the API is open to anyone who can reach the port.
LEXITAG_AUTH_TOKEN=

# ── Environment ──
# Set to "production" for Docker/server deployments.
# Controls: debug logging, Swagger UI, CORS strictness.
ENV=production

# ── Paths (inside Docker container) ──
MUSIC_DIR=/app/music
DATA_DIR=/app/data

# ── CORS ──
# Comma-separated list of allowed origins. Leave empty to restrict to same-origin only.
# Example: ALLOWED_ORIGINS=https://yourdomain.com
ALLOWED_ORIGINS=

# ── Google Custom Search (optional) ──
# Provides up to 100 free searches/day as a fallback when the default search fails.
#
# Step 1 — Create a Custom Search Engine (free):
#   https://programmablesearchengine.google.com → Add → set "Search the entire web"
#   Copy the Search Engine ID below.
#
# Step 2 — Enable the API and get a key (free):
#   https://console.cloud.google.com → APIs → Custom Search API → Enable
#   Create credentials → API key → copy below.
#
GOOGLE_CSE_KEY=
GOOGLE_CSE_CX=
